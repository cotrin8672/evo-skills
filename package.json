{
  "name": "evo-skills",
  "version": "0.1.0",
  "description": "Evidence-based skill improvements with isolated workers and versioned adoption",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "keywords": ["pi-package"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cotrin8672/evo-skills.git"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "files": ["src", "README.md"],
  "scripts": {
    "lint": "oxlint --deny-warnings src test",
    "typecheck": "tsrs --noEmit",
    "test": "bun test",
    "check": "oxlint --deny-warnings src test && tsrs --noEmit && bun test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^24.0.0",
    "oxlint": "1.94.0",
    "tsrs": "7.1.0-beta.tsrs2",
    "typebox": "1.3.27"
  }
}
